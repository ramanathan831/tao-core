@Library('tao-jenkins-shared-library') _
import org.tao.PodTemplates
import org.tao.TaoConfig

// ============================================================================
// PROJECT INITIALIZATION
// ============================================================================

TaoConfig.init([
    projectName: 'tao-core',
    
    // CI author info
    ciAuthorName: 'TAO CI Bot',
    ciAuthorEmail: 'christwang@nvidia.com',
    podLabelPrefix: 'tao-core-release',
    
    // Registries
    registries: [
        NGC: [
            url: 'https://nvcr.io',
            host: 'nvcr.io'
        ],
        GITLAB: [
            url: 'https://gitlab-master.nvidia.com',
            connection: 'git-lab-master'
        ],
        ARTIFACTORY: [
            url: 'https://artifactory.nvidia.com/artifactory/',
            pypiRepo: 'sw-tao-pypi-local'
        ]
    ],
    
    // Credentials
    credentials: [
        NGC_API_KEY: 'NGC_FTMS_API_KEY',
        NGC_CLI_KEY: 'NGC_FTMS_API_KEY',
        ARTIFACTORY: 'tao-artifactory-tkn-christwang',
        JIRA_TOKEN: 'TAO-jira-token',
        JENKINS_API_TOKEN: 'jenkins-api-token'
    ],
    
    // Docker images
    images: [
        PYTORCH_BASE: 'nvcr.io/nvidia/pytorch:24.03-py3',
        SONAR_SCANNER: 'sonarsource/sonar-scanner-cli:11'
    ],
    
    // Kubernetes
    kubernetes: [
        cloud: 'sc-ipp-blossom-prod',
        imagePullSecrets: ['tltimagepullsecret']
    ],
    
    // Jira configuration
    jira: [
        server: 'https://jirasw.nvidia.com/',
        projectKey: 'TLT',
        username: 'hqtran@nvidia.com'
    ],
    
    // GitLab project
    gitlab: [
        projectId: '140075'
    ]
])

// Initialize PodTemplates
PodTemplates.init([
    imagePullSecrets: TaoConfig.kubernetes.imagePullSecrets,
    
    containers: [
        'sonar': [
            image: TaoConfig.images.SONAR_SCANNER,
            command: ['cat'],
            tty: true
        ],
        'pyt': [
            image: TaoConfig.images.PYTORCH_BASE,
            privileged: true,
            command: ['cat'],
            tty: true,
            resources: [
                requests: ['nvidia.com/gpu': 1, memory: '16Gi'],
                limits: ['nvidia.com/gpu': 1, memory: '32Gi']
            ]
        ]
    ],
    
    affinityPools: [
        'tao-gpu-pool': [
            gpuTypes: ['A100_PCIE_40GB', 'A40', 'L40', 'A100_80GB_PCIe', 'TITAN_V'],
            driverVersions: ['580.35', '570.41', '570.14', '560.35.03', '550.54.15', '535.104.05', '535.74', '525.60.13', '510.41'],
            os: 'linux',
            arch: 'amd64'
        ]
    ]
])

// ============================================================================
// PIPELINE PARAMETERS
// ============================================================================

def TAO_VERSION = normalizeVersion(params.TAO_VERSION ?: "6.25.9")
def BUILD_TYPE = "rc"
def FORCE_REBUILD = params.FORCE_REBUILD ?: false
def SKIP_PROD_PROMOTE = params.SKIP_PROD_PROMOTE ?: false

// ============================================================================
// PIPELINE EXECUTION
// ============================================================================

podTemplate(cloud: TaoConfig.kubernetes.cloud, yaml: PodTemplates.generate(
    label: 'tao-core-release',
    containers: ['sonar', 'pyt'],
    affinityPool: 'tao-gpu-pool'
)) {
    try {
        node(POD_LABEL) {
            // Parse version components
            def versionInfo = normalizeVersion.parse(TAO_VERSION)
            def MAJOR_MINOR = versionInfo.majorMinor
            def PATCH_NUMBER = versionInfo.patch
            
            // Construct version string
            def VER
            if (params.RC) {
                VER = "${MAJOR_MINOR}.${PATCH_NUMBER}${BUILD_TYPE}${BUILD_NUMBER}"
            } else {
                VER = "${MAJOR_MINOR}.${PATCH_NUMBER}"
            }
            
            def PYTHON_VERSION
            
            container('pyt') {
                PYTHON_VERSION = sh(script: 'python -c "import platform; print(platform.python_version())"', returnStdout: true).trim()
                
                stage('checkout') {
                    withGitLabStatus('checkout') {
                        checkoutWithSafeDirectory()
                    }
                }
                
                stage('detect_skip_build') {
                    withGitLabStatus('detect_code_changes') {
                        script {
                            def skipResult = detectSkipBuild.checkAndSetEnv(
                                taoVersion: TAO_VERSION,
                                isRC: params.RC,
                                forceRebuild: FORCE_REBUILD,
                                skipProdPromote: SKIP_PROD_PROMOTE
                            )
                        }
                    }
                }
                
                // Only run build stages if not skipping
                if (env.SKIP_BUILD != 'true') {
                    stage('patch_build_files') {
                        withGitLabStatus('patch_build_files') {
                            patchVersion(TAO_VERSION)
                        }
                    }
                    
                    // Functional tests only for RC builds
                    if (params.RC) {
                        stage('functional_tests') {
                            withCredentials([string(credentialsId: TaoConfig.credentials.NGC_CLI_KEY, variable: 'NGC_CLI_API_KEY')]) {
                                script {
                                    env.NGC_KEY = NGC_CLI_API_KEY
                                    env.NGC_PATH = 'ea-tlt/tao_ea/pretrained_dino_imagenet:fan_hybrid_tiny'
                                }
                            }
                            withGitLabStatus('functional_tests') {
                                sh "pip install pytest-cov"
                                sh "CPUCOUNT=1 pip install . && pytest --cov=nvidia_tao_core --cov-report=xml:coverage.xml --cov-report=term"
                                archiveArtifacts artifacts: 'coverage.xml', fingerprint: true, allowEmptyArchive: true
                            }
                        }
                    }
                }
            }
            
            // SonarQube analysis for RC builds only - run in sonar container
            if (params.RC && env.SKIP_BUILD != 'true') {
                container('sonar') {
                    stage('sonarqube_analysis') {
                        catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                            withGitLabStatus('sonarqube_analysis') {
                                runSonarQubeAnalysis(
                                    sources: 'nvidia_tao_core',
                                    tests: 'nvidia_tao_core/tests',
                                    coverageReport: "${env.PWD}/coverage.xml",
                                    additionalProps: [
                                        'sonar.exclusions': 'nvidia_tao_core/tests/**'
                                    ],
                                    failOnError: false
                                )
                            }
                        }
                    }
                }
            }
            
            // Continue with remaining stages in pyt container
            container('pyt') {
                if (env.SKIP_BUILD != 'true') {
                    // Store wheel install locations for metadata
                    def rcWheelInstallLocation = ""
                    def finalWheelInstallLocation = ""
                    
                    // RC Wheel Stage - Build and publish RC version wheel (only for RC builds)
                    if (params.RC) {
                        stage('rc_wheel') {
                            withGitLabStatus('rc_wheel') {
                                script {
                                    // Build RC wheel with pyarmor obfuscation
                                    def rcBuildResult = buildObfuscatedWheel(
                                        version: TAO_VERSION,
                                        buildType: BUILD_TYPE,
                                        isRC: true,
                                        packageName: 'nvidia_tao_core',
                                        pyarmorRegFile: 'release/python/pyarmor-regfile-1219.zip',
                                        obfuscateFile: 'telemetry/metrics.py',
                                        cleanBefore: true
                                    )
                                    
                                    // Publish RC wheel and capture install location
                                    def rcPublishResult = publishWheel(
                                        version: rcBuildResult.wheelVersion,
                                        componentName: 'nvidia-tao-core'
                                    )
                                    rcWheelInstallLocation = rcPublishResult.wheelInstallLocation
                                    
                                    echo "✓ RC wheel published: ${rcBuildResult.wheelVersion}"
                                }
                            }
                        }
                    }
                    
                    // Final Wheel Stage - Build and publish final version wheel
                    if (!SKIP_PROD_PROMOTE) {
                        stage('final_wheel') {
                            withGitLabStatus('final_wheel') {
                                script {
                                    def FINAL_VER = "${MAJOR_MINOR}.${PATCH_NUMBER}"
                                    
                                    // Build final wheel (non-RC version) with pyarmor obfuscation
                                    // Need to rebuild if we already built RC wheel
                                    if (params.RC) {
                                        sh "rm -rf dist/*"
                                    }
                                    
                                    buildObfuscatedWheel(
                                        version: TAO_VERSION,
                                        isRC: false,
                                        packageName: 'nvidia_tao_core',
                                        pyarmorRegFile: 'release/python/pyarmor-regfile-1219.zip',
                                        obfuscateFile: 'telemetry/metrics.py',
                                        cleanBefore: params.RC ? false : true  // Only clean if we haven't built RC
                                    )
                                    
                                    // Publish final wheel and capture install location
                                    def finalPublishResult = publishWheel(
                                        version: FINAL_VER,
                                        componentName: 'nvidia-tao-core',
                                        overwrite: true  // Delete existing wheel before upload
                                    )
                                    finalWheelInstallLocation = finalPublishResult.wheelInstallLocation
                                    
                                    echo "✓ Final wheel published: ${FINAL_VER}"
                                }
                            }
                        }
                    } else {
                        echo "⏭ Skipping final version wheel (SKIP_PROD_PROMOTE = true)"
                    }
                    
                    stage('clean_up') {
                        withGitLabStatus('clean_up') {
                            cleanPythonBuild(
                                setupFile: 'setup.py',
                                removeDist: true,
                                removePycache: true,
                                removeEggInfo: true
                            )
                        }
                    }
                    
                    stage('archive_metadata') {
                        withGitLabStatus('archive_metadata') {
                            archiveReleaseMetadata(
                                taoVersion: TAO_VERSION,
                                wheelVersion: VER,
                                isRC: params.RC,
                                forceRebuild: FORCE_REBUILD,
                                skipProdPromote: SKIP_PROD_PROMOTE,
                                componentName: 'nvidia-tao-core',
                                pythonVersion: PYTHON_VERSION,
                                wheelInstallLocation: rcWheelInstallLocation,
                                finalWheelInstallLocation: finalWheelInstallLocation
                            )
                        }
                    }
                }  // End of if (env.SKIP_BUILD != 'true')
            }  // End of pyt container
        }  // End of node
    }
    catch (Exception e) {
        currentBuild.result = 'FAILURE'
        node(POD_LABEL) {
            container('pyt') {
                stage('Jira Notification on Failure') {
                    createJiraIssue(
                        summary: "Pipeline '${env.JOB_NAME}' Failure",
                        description: "The pipeline \"${env.JOB_NAME}\" has failed.\nLink to the build: ${env.BUILD_URL}",
                        issueType: 'Bug'
                    )
                }
            }
        }
        throw e
    }
}
