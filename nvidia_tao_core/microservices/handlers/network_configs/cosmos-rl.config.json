{
    "api_params": {
        "dataset_type": "vlm",
        "actions": ["train"],
        "formats": ["llava"],
        "accepted_ds_intents": ["training", "evaluation", "testing"],
        "image": "COSMOS_RL",
        "spec_backend": "toml",
        "actions_pipe": {
            "train": "train"
        }
    },

    "data_sources": {
        "train": {
            "custom.dataset.annotation_path": {
                "source": "train_datasets",
                "multiple_sources": false,
                "path": "annotations.json"
            },
            "custom.dataset.media_path": {
                "source": "train_datasets",
                "multiple_sources": false,
                "path": "images.tar.gz"
            }
        }
    },
    "spec_params":{
        "train": {
            "results_dir":"output_dir",
            "train.output_dir":"output_dir"
        }
    },

    "automl_spec_params":{
        "results_dir":"automl_output_dir",
        "train.output_dir":"automl_output_dir"
    },

    "metrics": {
        "available_metrics": [
            "grad_norm",
            "train_runtime",
            "train_samples_per_second",
            "train_steps_per_second",
            "val_acc",
            "reward_mean",
            "reward_std",
            "reward_max",
            "reward_min",
            "completion_length_mean",
            "completion_length_max",
            "train_loss_avg",
            "train_loss_max",
            "loss_avg",
            "loss_max",
            "learning_rate",
            "iteration_time",
            "policy_loss",
            "value_loss",
            "kl_divergence",
            "kl_loss_avg",
            "training_progress",
            "remaining_steps",
            "eta_seconds",
            "val_reward_avg",
            "val_reward_std",
            "val_reward_max",
            "val_reward_min",
            "val_rollout_count",
            "val_step",
            "val_completion_length_avg",
            "val_completion_length_std",
            "val_completion_length_max",
            "val_completion_length_min",
            "total_steps",
            "final_step",
            "completion_percentage",
            "model_parallelism",
            "data_parallelism",
            "batch_size_per_replica",
            "warmup_steps",
            "steps_per_epoch",
            "active_replicas",
            "remaining_replicas",
            "replica_count",
            "n_atoms",
            "old_total_steps",
            "new_total_steps",
            "rollout_reward",
            "rollout_prompt_length",
            "rollout_completion_length",
            "profile_finished",
            "progress_pct",
            "total_validation_rollouts",
            "remain_samples",
            "n_replicas",
            "max_epochs",
            "current_step",
            "epoch",
            "training_phase",
            "validation_phase",
            "validation_step",
            "active_rollout_replicas",
            "was_in_mesh",
            "policy_init_done",
            "total_replicas",
            "mesh_type",
            "replica_names",
            "remaining_samples",
            "training_completed",
            "old_status",
            "new_status",
            "replica_type",
            "training_finished",
            "operation",
            "component",
            "status",
            "cloud_upload",
            "step_name",
            "event",
            "error_type",
            "error_message",
            "interrupted",
            "failed"
        ],
        "monitoring_metric": "val_acc"
    }
}
