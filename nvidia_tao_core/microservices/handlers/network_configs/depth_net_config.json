{
    "api_params": {
        "dataset_type":"depth_net",
        "actions": ["train"],
        "formats":["depth_net_mono", "depth_net_stereo"],
        "accepted_ds_intents": ["training"],
        "image":"TAO_PYTORCH",
        "spec_backend":"yaml",
        "actions_pipe":{
            "train":"train"
        }
    },

    "dataset_validation": {
        "required_files": {
            "depth_net_stereo": [
                {
                    "all_of": [
                        {"path": "middlebury_sample.tar.gz", "type": "file"},
                        {"path": "middlebury_test_split.txt", "type": "file"}
                    ]
                }
            ],
            "depth_net_mono": [
                {
                    "all_of": [
                        {"path": "middlebury_sample.tar.gz", "type": "file"},
                        {"path": "middlebury_test_split.txt", "type": "file"}
                    ]
                }
            ]
        }
    },

    "data_sources": {
        "train": {
            "dataset": {
                "source": "train_datasets",
                "multiple_sources": true,
                "mapping": {
                    "dataset_name": {
                        "path": "MonoDataset"
                    },
                    "train_dataset.data_sources.dataset_name": {
                        "path": "Middlebury"
                    },
                    "train_dataset.data_sources.data_file": {
                        "path": "train.txt"
                    }
                },
                "conditional": {
                    "metadata_key": "format",
                    "equals": "depth_net_mono"
                }
            }
        }
    },

    "spec_params":{
        "train": {
            "results_dir":"output_dir",
            "encryption_key":"key",
            "train.pretrained_model_path": "ptm_if_no_resume_model",
            "model.backbone.pretrained_backbone_path": "ptm_if_no_resume_model",
            "train.resume_training_checkpoint_path": "resume_model"
        }
    },

    "automl_spec_params":{
        "results_dir":"automl_output_dir",
        "train.pretrained_model_path":"automl_assign_ptm",
        "model.backbone.pretrained_backbone_path": "automl_assign_ptm",
        "train.resume_training_checkpoint_path":"automl_resume_model",
        "train.checkpoint_interval":"assign_const_value,train.num_epochs",
        "train.validation_interval":"assign_const_value,train.num_epochs,train.checkpoint_interval",
        "encryption_key":"key"
    },

    "metrics": {
        "available_metrics": ["val_acc"],
        "monitoring_metric": "val_acc"
    }
}