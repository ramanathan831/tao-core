{
    "api_params": {
        "dataset_type":"image_classification",
        "actions": ["train","export","inference"],
        "formats":["ssl"],
        "accepted_ds_intents": ["training", "evaluation", "testing"],
        "image":"TAO_PYTORCH",
        "spec_backend":"yaml",
        "actions_pipe":{
            "train":"train",
            "evaluate":"evaluate",
            "inference":"inference"
        }
    },

    "data_sources": {
        "train": {
            "dataset.train_dataset.images_dir": {
                "source": "train_datasets",
                "multiple_sources": false,
                "path": "images_train.tar.gz"
            }
        },
        "evaluate": {
            "dataset.val_dataset.images_dir": {
                "source": "eval_dataset",
                "multiple_sources": false,
                "path": "images_val.tar.gz"
            }
        },
        "inference": {
            "dataset.test_dataset.images_dir": {
                "source": "inference_dataset",
                "multiple_sources": false,
                "path": "images_test.tar.gz"
            }
        }
    },

    "spec_params":{
        "train": {
            "results_dir":"output_dir",
            "model.pretrained_backbone_path":"ptm_if_no_resume_model",
            "train.pretrained_model_path":"ptm_if_no_resume_model",
            "train.resume_training_checkpoint_path":"resume_model",
            "encryption_key":"key"
        },
        "inference":{
            "results_dir":"output_dir",
            "inference.checkpoint":"parent_model",
            "inference.trt_engine":"parent_model",
            "encryption_key":"key"
        },
        "evaluate":{
            "results_dir":"output_dir",
            "evaluate.checkpoint":"parent_model",
            "evaluate.trt_engine":"parent_model",
            "encryption_key":"key"
        }
    },

    "automl_spec_params":{
        "results_dir":"automl_output_dir",
        "model.pretrained_backbone_path":"automl_assign_ptm",
        "train.pretrained_model_path":"ptm_if_no_resume_model",
        "train.resume_training_checkpoint_path":"automl_resume_model",
        "train.checkpoint_interval":"assign_const_value,train.num_epochs",
        "train.validation_interval":"assign_const_value,train.num_epochs,train.checkpoint_interval",
        "encryption_key":"key"
    },

    "metrics": {
        "available_metrics": ["train_loss"],
        "monitoring_metric": "train_loss"
    }
}