podTemplate (cloud:'sc-ipp-blossom-prod', yaml : """
apiVersion: v1
kind: Pod
metadata:
    labels:
        some-label: tao-core-build
spec:
    imagePullSecrets:
      - name: tltimagepullsecret
    containers:
    - name: docker
      image: docker:24.0.5-dind
      securityContext:
        privileged: true
      env:
        - name: DOCKER_TLS_CERTDIR
          value: ""
    - name: pyt
      image: nvcr.io/nvidia/pytorch:24.03-py3
      securityContext:
        privileged: true
      command:
      - cat
      resources:
        requests:
          nvidia.com/gpu: 1
          memory: "16Gi"
        limits:
          nvidia.com/gpu: 1
          memory: "32Gi"
      tty: true
    restartPolicy: Never
    backoffLimit: 4
    nodeSelector:
      kubernetes.io/os: linux
      nvidia.com/driver_version: "510.41"
      nvidia.com/gpu_type: TITAN_V
    """
)
{
  // Global configuration
  // Set this to true and uncomment the APT stages below to enable APT package processing
  def ENABLE_APT = false
  
  node(POD_LABEL) {
    container('pyt') {
      def BUILD_TYPE="dev0"
      def TAO_WHEEL_VERSION="5.3.0"
      def VER="${TAO_WHEEL_VERSION}.${BUILD_NUMBER}.${BUILD_TYPE}"
      def PYTHON_VERSION=sh(script: 'python -c "import platform; print(platform.python_version())"', returnStdout: true).trim()
      def SRC="dist/nvidia_tao_core-${VER}-py3-none-any.whl"
      def TARGET="sw-tao-pypi-local/nvidia-tao-core-dev/${VER}/${PYTHON_VERSION}/"
      def PROP="component_name=nvidia-tao-core;arch=x86_64;os=linux;build_source=None;version=${VER};branch=main;release_approver=vpraveen"
      
      // GitLab related
      def GITLAB_PROJECT_ID = "140075" 
      def TAG_NAME = "v${VER}"
      def RELEASE_NAME = "Release ${VER}"
      def RELEASE_DESCRIPTION = "Release ${VER} with third-party packages"
      
      // Directory paths
      def WHEELS_DIR = "third_party_wheels"
      def APT_DIR = "third_party_apt"
      def APT_SOURCES_DIR = "third_party_apt_sources"
      
      stage ('checkout') {
        gitlabCommitStatus(name: "checkout", connection: gitLabConnection('git-lab-master')) {
          checkout scm
          echo "APT package processing: ${ENABLE_APT ? 'ENABLED' : 'DISABLED (set ENABLE_APT to true to enable)'}"
          // To enable APT processing:
          // 1. Set ENABLE_APT to true at the top of this file
          // 2. Uncomment the APT-related stages below
        }
      }

      stage ('static_tests') {
        gitlabCommitStatus(name: "static_tests", connection: gitLabConnection('git-lab-master')) {
          sh "pip install pylint==3.0.3 pydocstyle flake8"
          sh "python3 ci/run_static_tests.py"
        }
      }

      stage ("functional_tests") {
        withCredentials([string(credentialsId: 'NGC_CLI_API_KEY_SVC_TLT_CI', variable: 'NGC_CLI_API_KEY')]) {
          script{
            env.NGC_KEY=NGC_CLI_API_KEY
            env.NGC_PATH='ea-tlt/tao_ea/pretrained_dino_imagenet:fan_hybrid_tiny'
          }
        }
        gitlabCommitStatus(name: "functional_tests", connection: gitLabConnection('git-lab-master')) {
          sh "pip install . && pytest"
        }
      }

      stage ('build_pyt_wheel') {
        gitlabCommitStatus(name: "build_wheel", connection: gitLabConnection('git-lab-master')) {
          sh "echo '${BUILD_NUMBER}-${BUILD_TYPE}' > build.info"
          sh "bash release/python/build_wheel.sh"
        }
      }
      
      stage ('publish_pyt_wheel') {
        gitlabCommitStatus(name: "build_wheel", connection: gitLabConnection('git-lab-master')) {
          withCredentials([usernamePassword(credentialsId: 'tao-artifactory-tkn', passwordVariable: 'JFROG_PASSWORD', usernameVariable: 'JFROG_USERNAME')]) {
              sh "bash release/python/install_jfrog.sh"
              sh "jf rt u --url=https://urm.nvidia.com/artifactory/ --user=${JFROG_USERNAME} --password=${JFROG_PASSWORD} --target-props '${PROP}' ${SRC} ${TARGET}"
          }
        }
      }

      stage ('download_third_party_wheels') {
        gitlabCommitStatus(name: "download_third_party_wheels", connection: gitLabConnection('git-lab-master')) {
          // Create a default requirements.txt if it doesn't exist yet
          sh """
          if [ ! -f requirements.txt ]; then
            echo "# Python packages required for TAO" > requirements.txt
            # Add specific dependencies to the file as needed
          fi
          """
          
          // Run the helper script to download third party wheels from requirements.txt
          sh "python3 scripts/download_third_party_wheels.py --requirements requirements.txt"
        }
      }

      stage ('publish_third_party_wheels') {
        gitlabCommitStatus(name: "publish_third_party_wheels", connection: gitLabConnection('git-lab-master')) {
          // Debug info
          sh "echo 'DEBUG: Starting publish_third_party_wheels stage'"
          sh "echo 'DEBUG: GITLAB_PROJECT_ID=${GITLAB_PROJECT_ID}'"
          
          // Check for script existence and permissions
          sh "ls -la scripts/upload_wheels_to_gitlab.py || echo 'Script not found!'"
          sh "chmod +x scripts/upload_wheels_to_gitlab.py || echo 'Failed to set exec permissions'"
          
          // Ensure required dependencies are installed
          sh "pip install --quiet requests || echo 'Failed to install requests library'"
          
          withCredentials([string(credentialsId: 'gitlab-api-token', variable: 'GITLAB_TOKEN')]) {
            sh """
            export GITLAB_PROJECT_ID=${GITLAB_PROJECT_ID}
            export TAG_NAME=${TAG_NAME}
            export RELEASE_NAME="${RELEASE_NAME}"
            export RELEASE_DESCRIPTION="${RELEASE_DESCRIPTION}"
            export WHEELS_DIR=${WHEELS_DIR}
            export DEBUG=1
            
            # Print Python version for debugging
            python3 --version
            
            # Script Debugging
            python3 -u scripts/upload_wheels_to_gitlab.py || {
              echo "ERROR: Script execution failed with code \$?"
              # Try to see if the script has syntax errors
              python3 -m py_compile scripts/upload_wheels_to_gitlab.py || echo "Syntax error in script"
            }
            """
          }
        }
      }
      
      // Comment out APT related stages
      /*
      // ======= BEGIN APT PROCESSING STAGES (UNCOMMENT AND SET ENABLE_APT=true TO ENABLE) =======
      stage ('download_third_party_apt') {
        when {
          expression { return ENABLE_APT }
        }
        gitlabCommitStatus(name: "download_third_party_apt", connection: gitLabConnection('git-lab-master')) {
          echo "DEBUG: APT processing is enabled, downloading packages"
          
          // Run the helper script to download third party apt packages
          sh "python3 scripts/download_apt_packages.py --requirements apt-requirements.txt --download-sources"
        }
      }
      
      stage ('publish_third_party_apt') {
        when {
          expression { return ENABLE_APT }
        }
        gitlabCommitStatus(name: "publish_third_party_apt", connection: gitLabConnection('git-lab-master')) {
          // Debug info
          echo "DEBUG: APT processing is enabled, uploading packages"
          sh "echo 'DEBUG: Starting publish_third_party_apt stage'"
          sh "echo 'DEBUG: GITLAB_PROJECT_ID=${GITLAB_PROJECT_ID}'"
          
          // Check for script existence and permissions
          sh "ls -la scripts/upload_apt_to_gitlab.py || echo 'Script not found!'"
          sh "chmod +x scripts/upload_apt_to_gitlab.py || echo 'Failed to set exec permissions'"
          
          // Ensure required dependencies are installed
          sh "pip install --quiet requests || echo 'Failed to install requests library'"
          
          // Upload the apt packages as GitLab release artifacts
          withCredentials([string(credentialsId: 'gitlab-api-token', variable: 'GITLAB_TOKEN')]) {
            // Use the dedicated script to upload apt packages as GitLab release artifacts
            sh """
            export GITLAB_PROJECT_ID=${GITLAB_PROJECT_ID}
            export TAG_NAME=${TAG_NAME}
            export RELEASE_NAME="${RELEASE_NAME}"
            export RELEASE_DESCRIPTION="${RELEASE_DESCRIPTION}"
            export APT_DIR=${APT_DIR}
            export DEBUG=1
            
            # Print Python version for debugging
            python3 --version
            
            # Script Debugging
            python3 -u scripts/upload_apt_to_gitlab.py || {
              echo "ERROR: Script execution failed with code \$?"
              # Try to see if the script has syntax errors
              python3 -m py_compile scripts/upload_apt_to_gitlab.py || echo "Syntax error in script"
            }
            """
          }
        }
      }
      // ======= END APT PROCESSING STAGES (UNCOMMENT ABOVE AND SET ENABLE_APT=true TO ENABLE) =======
      */

      stage ('generate_license_acknowledgements') {
        gitlabCommitStatus(name: "generate_license_acknowledgements", connection: gitLabConnection('git-lab-master')) {
          // Generate license acknowledgements from downloaded packages and upload to GitLab
          // Include APT packages only if enabled
          def aptFlag = ENABLE_APT ? "--include-apt" : ""
          echo "DEBUG: APT package inclusion in licenses: ${ENABLE_APT ? 'ENABLED' : 'DISABLED'}"
          
          // Execute the script which handles both generation and uploading
          withCredentials([string(credentialsId: 'gitlab-api-token', variable: 'GITLAB_TOKEN')]) {
            sh """
            export GITLAB_PROJECT_ID=${GITLAB_PROJECT_ID}
            export TAG_NAME=${TAG_NAME}
            export RELEASE_NAME="${RELEASE_NAME}"
            export RELEASE_DESCRIPTION="${RELEASE_DESCRIPTION}"
            export DEBUG=1
            
            python3 -u scripts/upload_license_to_gitlab.py ${aptFlag}
            """
          }
          
          // Archive the generated acknowledgements file as a build artifact
          archiveArtifacts artifacts: 'acknowledgements.md', onlyIfSuccessful: true
        }
      }

      stage ('cleanup_third_party_packages') {
        gitlabCommitStatus(name: "cleanup_third_party_packages", connection: gitLabConnection('git-lab-master')) {
          // Define what to clean up based on ENABLE_APT
          def dirsToClean = "${WHEELS_DIR}"
          if (ENABLE_APT) {
            echo "DEBUG: APT enabled, adding APT directories to cleanup list"
            dirsToClean += " ${APT_DIR} ${APT_SOURCES_DIR}"
          }
          
          // Clean up the directories
          echo "DEBUG: Cleaning up directories: ${dirsToClean}"
          sh "rm -rf ${dirsToClean}"
        }
      }
    }
    
    // container('docker') {
    //   stage ('wheeltamer_tests') {
    //     gitlabCommitStatus(name: "wheeltamer_tests", connection: gitLabConnection('git-lab-master')) {
    //       docker.withRegistry('https://gitlab-master.nvidia.com:5005', 'tao-launcher-api-ptkn') {
    //         sh "docker pull gitlab-master.nvidia.com:5005/dl/pypi/wheel-ci-cd:wheeltamer"
    //         sh "docker run --rm -v ${WORKSPACE}/dist:/workspace \
    //             -e 'EXPECTED_PKG_LICENSE=NVIDIA Proprietary Software' \
    //             -e 'ALLOWED_NOSEC_COUNT=0' \
    //             gitlab-master.nvidia.com:5005/dl/pypi/wheel-ci-cd:wheeltamer /bin/bash -c 'wheeltamer'"
    //       }
    //     }
    //   }
    // }
  }
}

