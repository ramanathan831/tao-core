// Global variables
def TAO_VERSION = "6.25.7"
def BUILD_TYPE = "dev"

podTemplate (cloud:'sc-ipp-blossom-prod', yaml : """
apiVersion: v1
kind: Pod
metadata:
    labels:
        some-label: tao-core-build
spec:
    imagePullSecrets:
      - name: tltimagepullsecret
    containers:
    - name: sonar
      image: sonarsource/sonar-scanner-cli:11
      command:
      - cat
      tty: true
    - name: pyt
      image: nvcr.io/nvidia/pytorch:25.01-py3
      securityContext:
        privileged: true
      command:
      - cat
      resources:
        requests:
          nvidia.com/gpu: 1
          memory: "16Gi"
        limits:
          nvidia.com/gpu: 1
          memory: "32Gi"
      tty: true
    restartPolicy: Never
    backoffLimit: 4
    affinity:
      nodeAffinity:
        requiredDuringSchedulingIgnoredDuringExecution:
          nodeSelectorTerms:
          - matchExpressions:
            - key: nvidia.com/gpu_type
              operator: In
              values:
              - A100_PCIE_40GB
              - A40
              - L40
              - A100_80GB_PCIe
              - TITAN_V
            - key: nvidia.com/driver_version
              operator: In
              values:
              - 580.35
              - 570.41
              - 570.14
              - 560.35.03
              - 550.54.15
              - 535.104.05
              - 535.74
              - 525.60.13
              - 510.41
            - key: kubernetes.io/os
              operator: In
              values:
              - linux
    """
)
{
  // Stage 1: Parallel execution of x86 and ARM tests
  parallel (
    "x86_tests": {
      node(POD_LABEL) {
        container('pyt') {
          try {
            stage ('checkout_x86') {
              gitlabCommitStatus(name: "checkout_x86", connection: gitLabConnection('git-lab-master')) {
                checkout scm
              }
            }

            stage ("functional_tests_x86") {
              withCredentials([string(credentialsId: 'NGC_CLI_API_KEY_SVC_TLT_CI', variable: 'NGC_CLI_API_KEY')]) {
                script{
                  env.NGC_KEY=NGC_CLI_API_KEY
                  env.NGC_PATH='ea-tlt/tao_ea/pretrained_dino_imagenet:fan_hybrid_tiny'
                }
              }
              gitlabCommitStatus(name: "functional_tests_x86", connection: gitLabConnection('git-lab-master')) {
                sh "pip install pytest-cov"
                sh "pip install . && pytest --cov=nvidia_tao_core --cov-report=xml:coverage.xml --cov-report=term"
                // Archive the coverage report
                archiveArtifacts artifacts: 'coverage.xml', fingerprint: true, allowEmptyArchive: true
              }
            }
          } finally {
            stage ('cleanup_x86') {
              catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                sh """
                  echo "Clearing build and dists"
                  python setup.py clean --all
                  echo "Clearing pycache and pycs"
                  find . | grep -E '(__pycache__|[.]pyc|[.]pyo\$)' | xargs rm -rf
                """
              }
            }
          }
        }
        
        // Run SonarQube analysis in sonar container within the same node
        container('sonar') {
          stage ('sonarqube_analysis_x86') {
            catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
              gitlabCommitStatus(name: "sonarqube_analysis_x86", connection: gitLabConnection('git-lab-master')) {
                def branchName = params.GITLAB_BRANCH ?: params.BRANCH_NAME ?: env.BRANCH_NAME ?: env.GIT_BRANCH?.replaceFirst(/^origin\//, '') ?: 'main'
                echo "Analyzing branch: ${branchName}"
                echo "Available parameters: GITLAB_BRANCH=${params.GITLAB_BRANCH}, BRANCH_NAME=${params.BRANCH_NAME}"
                echo "Available env vars: BRANCH_NAME=${env.BRANCH_NAME}, GIT_BRANCH=${env.GIT_BRANCH}"
                
                // Verify coverage file exists and show its location
                sh "pwd && ls -la coverage.xml || echo 'Coverage file not found!'"
                
                withSonarQubeEnv() {
                  sh "sonar-scanner -Dsonar.python.coverage.reportPaths=\${PWD}/coverage.xml -Dsonar.sources=nvidia_tao_core -Dsonar.tests=nvidia_tao_core/tests -Dsonar.exclusions=nvidia_tao_core/tests/** -Dsonar.branch.name=${branchName}"
                }
                echo "SonarQube analysis completed successfully"
              }
            }
          }
        }
      }
    },
    "arm_tests": {
      node('GB200-ARM') {
        try {
          stage('checkout_arm') {
            gitlabCommitStatus(name: "checkout_arm", connection: gitLabConnection('git-lab-master')) {
              checkout scm
            }
          }

          stage('functional_tests_arm') {
            gitlabCommitStatus(name: "functional_tests_arm", connection: gitLabConnection('git-lab-master')) {
              withCredentials([string(credentialsId: 'NGC_CLI_API_KEY_SVC_TLT_CI', variable: 'NGC_CLI_API_KEY')]) {
                script {
                  // Use the same Docker image as x86, but run on ARM node
                  def dockerImage = "nvcr.io/nvidia/pytorch:24.03-py3"
                  
                  // Create unique container name for this pipeline run to avoid conflicts
                  def containerName = "tao-arm-${BUILD_NUMBER}-${env.JOB_NAME.replaceAll('/', '-')}"
                  
                  // Set NGC environment variables (same as x86)
                  env.NGC_KEY=NGC_CLI_API_KEY
                  env.NGC_PATH='ea-tlt/tao_ea/pretrained_dino_imagenet:fan_hybrid_tiny'
                  
                  sh """
                    set -e
                    echo "Running functional tests on ARM using Docker"
                    
                    # Set variables for the shell script
                    DOCKER_IMAGE="${dockerImage}"
                    CONTAINER_NAME="${containerName}"
                    
                    # Pull the multi-arch Docker image
                    docker pull \$DOCKER_IMAGE
                    
                    # Run the same test logic as x86 but in Docker container on ARM
                    # Use pipeline-specific labels for safe cleanup
                    docker run --rm --gpus all \
                      --user \$(id -u):\$(id -g) \
                      --name \$CONTAINER_NAME \
                      --label "pipeline=tao-core-arm" \
                      --label "build=${BUILD_NUMBER}" \
                      --label "job=${env.JOB_NAME}" \
                      -v \$(pwd):/tao-core \
                      -w /tao-core \
                      -e HOME=/tao-core \
                      -e NGC_CLI_API_KEY=\$NGC_CLI_API_KEY \
                      -e NGC_KEY=\$NGC_CLI_API_KEY \
                      -e NGC_PATH='ea-tlt/tao_ea/pretrained_dino_imagenet:fan_hybrid_tiny' \
                      \$DOCKER_IMAGE \
                      bash -c \"set -e; pip install . && pytest\"
                  """
                }
              }
            }
          }
        } finally {
          stage('cleanup_arm') {
            catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
              echo "Cleaning up ARM node workspace and pipeline-specific Docker resources"
              sh """
                # Only clean up Docker resources specific to this pipeline run (safe for concurrent pipelines)
                echo "Cleaning up containers for this pipeline run..."
                PIPELINE_CONTAINERS=\$(docker ps -a --filter "label=pipeline=tao-core-arm" --filter "label=build=${BUILD_NUMBER}" --format "{{.ID}}" 2>/dev/null || echo "")
                if [ ! -z "\$PIPELINE_CONTAINERS" ]; then
                  echo "Removing pipeline-specific containers: \$PIPELINE_CONTAINERS"
                  docker rm -f \$PIPELINE_CONTAINERS || echo "Some containers already removed"
                else
                  echo "No pipeline-specific containers to clean up"
                fi
                
                # Clean up any containers with our specific job label that are exited (broader safety net)
                JOB_CONTAINERS=\$(docker ps -a --filter "label=job=${JOB_NAME}" --filter "status=exited" --format "{{.ID}}" 2>/dev/null || echo "")
                if [ ! -z "\$JOB_CONTAINERS" ]; then
                  echo "Removing exited containers from this job: \$JOB_CONTAINERS"
                  docker rm \$JOB_CONTAINERS || echo "Some job containers already removed"
                else
                  echo "No exited job containers to clean up"
                fi
                
                echo "Cleaning up dangling images only (safe for concurrent pipelines)..."
                docker image prune -f --filter "dangling=true" || echo "No dangling images to clean up"
                
                # Remove workspace contents
                rm -rf "${WORKSPACE}"/*
                
                echo "ARM cleanup completed (pipeline-specific, safe for concurrent runs)"
              """
            }
          }
        }
      }
    }
  )
}