    //             else
    //               echo "No pipeline-specific containers to clean up"
    //             fi
    //             
    //             # Clean up any containers with our specific job label that are exited (broader safety net)
    //             JOB_CONTAINERS=\$(docker ps -a --filter "label=job=${JOB_NAME}" --filter "status=exited" --format "{{.ID}}" 2>/dev/null || echo "")
