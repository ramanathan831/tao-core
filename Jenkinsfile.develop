@Library('tao-jenkins-shared-library') _
import org.tao.PodTemplates
import org.tao.TaoConfig

// ============================================================================
// PROJECT INITIALIZATION
// ============================================================================

TaoConfig.init([
    projectName: 'tao-core',
    
    // CI author info
    ciAuthorName: 'TAO CI Bot',
    ciAuthorEmail: 'tao-rc-interest@nvidia.com',
    podLabelPrefix: 'tao-core-build',
    
    // Registries
    registries: [
        NGC: [
            url: 'https://nvcr.io',
            host: 'nvcr.io'
        ],
        GITLAB: [
            url: 'https://gitlab-master.nvidia.com',
            connection: 'git-lab-master'
        ]
    ],
    
    // Credentials
    credentials: [
        NGC_API_KEY: 'NGC_FTMS_API_KEY',
        NGC_CLI_KEY: 'NGC_FTMS_API_KEY'
    ],
    
    // Docker images
    images: [
        PYTORCH_BASE: 'nvcr.io/nvidia/pytorch:25.01-py3',
        SONAR_SCANNER: 'sonarsource/sonar-scanner-cli:11'
    ],
    
    // Kubernetes
    kubernetes: [
        cloud: 'sc-ipp-blossom-prod',
        imagePullSecrets: ['tltimagepullsecret']
    ]
])

// Initialize PodTemplates
PodTemplates.init([
    imagePullSecrets: TaoConfig.kubernetes.imagePullSecrets,
    
    containers: [
        'sonar': [
            image: TaoConfig.images.SONAR_SCANNER,
            command: ['cat'],
            tty: true
        ],
        'pyt': [
            image: TaoConfig.images.PYTORCH_BASE,
            privileged: true,
            command: ['cat'],
            tty: true,
            resources: [
                requests: ['nvidia.com/gpu': 1, memory: '16Gi'],
                limits: ['nvidia.com/gpu': 1, memory: '32Gi']
            ]
        ]
    ],
    
    affinityPools: [
        'tao-gpu-pool': [
            gpuTypes: ['A100_PCIE_40GB', 'A40', 'L40', 'A100_80GB_PCIe', 'TITAN_V'],
            driverVersions: ['580.35', '570.41', '570.14', '560.35.03', '550.54.15', '535.104.05', '535.74', '525.60.13', '510.41'],
            os: 'linux',
            arch: 'amd64'
        ]
    ]
])

// ============================================================================
// PIPELINE PARAMETERS
// ============================================================================

def TAO_VERSION = "6.25.9"
def BUILD_TYPE = "dev"

// ============================================================================
// PIPELINE EXECUTION
// ============================================================================

podTemplate(cloud: TaoConfig.kubernetes.cloud, yaml: PodTemplates.generate(
    label: 'tao-core-build',
    containers: ['sonar', 'pyt'],
    affinityPool: 'tao-gpu-pool'
)) {
    // Stage 1: Parallel execution of x86 and ARM tests
    parallel(
        "x86_tests": {
            node(POD_LABEL) {
                container('pyt') {
                    try {
                        stage('checkout_x86') {
                            withGitLabStatus('checkout_x86') {
                                checkoutWithSafeDirectory()
                            }
                        }

                        stage('functional_tests_x86') {
                            withCredentials([string(credentialsId: TaoConfig.credentials.NGC_CLI_KEY, variable: 'NGC_CLI_API_KEY')]) {
                                script {
                                    env.NGC_KEY = NGC_CLI_API_KEY
                                    env.NGC_PATH = 'ea-tlt/tao_ea/pretrained_dino_imagenet:fan_hybrid_tiny'
                                }
                            }
                            withGitLabStatus('functional_tests_x86') {
                                sh "pip install pytest-cov"
                                sh "CPUCOUNT=1 pip install . && pytest --cov=nvidia_tao_core --cov-report=xml:coverage.xml --cov-report=term"
                                archiveArtifacts artifacts: 'coverage.xml', fingerprint: true, allowEmptyArchive: true
                            }
                        }
                    } finally {
                        stage('cleanup_x86') {
                            catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                                cleanPythonBuild(
                                    setupFile: 'setup.py',
                                    removeDist: true,
                                    removePycache: true
                                )
                            }
                        }
                    }
                }
                
                // Run SonarQube analysis in sonar container within the same node
                container('sonar') {
                    stage('sonarqube_analysis_x86') {
                        catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                            withGitLabStatus('sonarqube_analysis_x86') {
                                runSonarQubeAnalysis(
                                    sources: 'nvidia_tao_core',
                                    tests: 'nvidia_tao_core/tests',
                                    coverageReport: "${env.PWD}/coverage.xml",
                                    additionalProps: [
                                        'sonar.exclusions': 'nvidia_tao_core/tests/**'
                                    ],
                                    failOnError: false
                                )
                            }
                        }
                    }
                }
            }
        }
        
        // ============================================================================
        // ARM TESTS - DISABLED
        // TODO: Re-enable ARM tests once we have ARM nodes (GB200-ARM) infrastructure
        // ============================================================================
        // "arm_tests": {
        //     node('GB200-ARM') {
        //         try {
        //             stage('checkout_arm') {
        //                 withGitLabStatus('checkout_arm') {
        //                     checkoutWithSafeDirectory()
        //                 }
        //             }
        //
        //             stage('functional_tests_arm') {
        //                 withGitLabStatus('functional_tests_arm') {
        //                     withCredentials([string(credentialsId: TaoConfig.credentials.NGC_CLI_KEY, variable: 'NGC_CLI_API_KEY')]) {
        //                         script {
        //                             // Use the same Docker image as x86, but run on ARM node
        //                             def dockerImage = TaoConfig.images.PYTORCH_BASE
        //                             
        //                             // Create unique container name for this pipeline run
        //                             def containerName = "tao-arm-${BUILD_NUMBER}-${env.JOB_NAME.replaceAll('/', '-')}"
        //                             
        //                             // Set NGC environment variables
        //                             env.NGC_KEY = NGC_CLI_API_KEY
        //                             env.NGC_PATH = 'ea-tlt/tao_ea/pretrained_dino_imagenet:fan_hybrid_tiny'
        //                             
        //                             sh """
        //                                 set -e
        //                                 echo "Running functional tests on ARM using Docker"
        //                                 
        //                                 DOCKER_IMAGE="${dockerImage}"
        //                                 CONTAINER_NAME="${containerName}"
        //                                 
        //                                 docker pull \$DOCKER_IMAGE
        //                                 
        //                                 docker run --rm --gpus all \\
        //                                     --user \$(id -u):\$(id -g) \\
        //                                     --name \$CONTAINER_NAME \\
        //                                     --label "pipeline=tao-core-arm" \\
        //                                     --label "build=${BUILD_NUMBER}" \\
        //                                     --label "job=${env.JOB_NAME}" \\
        //                                     -v \$(pwd):/tao-core \\
        //                                     -w /tao-core \\
        //                                     -e HOME=/tao-core \\
        //                                     -e NGC_CLI_API_KEY=\$NGC_CLI_API_KEY \\
        //                                     -e NGC_KEY=\$NGC_CLI_API_KEY \\
        //                                     -e NGC_PATH='ea-tlt/tao_ea/pretrained_dino_imagenet:fan_hybrid_tiny' \\
        //                                     \$DOCKER_IMAGE \\
        //                                     bash -c "set -e; pip install . && pytest"
        //                             """
        //                         }
        //                     }
        //                 }
        //             }
        //         } finally {
        //             stage('cleanup_arm') {
        //                 catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
        //                     echo "Cleaning up ARM node workspace and pipeline-specific Docker resources"
        //                     sh """
        //                         # Clean up containers for this pipeline run
        //                         PIPELINE_CONTAINERS=\$(docker ps -a --filter "label=pipeline=tao-core-arm" --filter "label=build=${BUILD_NUMBER}" --format "{{.ID}}" 2>/dev/null || echo "")
        //                         if [ ! -z "\$PIPELINE_CONTAINERS" ]; then
        //                             docker rm -f \$PIPELINE_CONTAINERS || echo "Some containers already removed"
        //                         fi
        //                         
        //                         # Clean up exited containers from this job
        //                         JOB_CONTAINERS=\$(docker ps -a --filter "label=job=${JOB_NAME}" --filter "status=exited" --format "{{.ID}}" 2>/dev/null || echo "")
        //                         if [ ! -z "\$JOB_CONTAINERS" ]; then
        //                             docker rm \$JOB_CONTAINERS || echo "Some job containers already removed"
        //                         fi
        //                         
        //                         # Clean dangling images
        //                         docker image prune -f --filter "dangling=true" || true
        //                         
        //                         # Remove workspace contents
        //                         rm -rf "${WORKSPACE}"/*
        //                     """
        //                 }
        //             }
        //         }
        //     }
        // }
    )
}
