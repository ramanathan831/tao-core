{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:recommended"],
    "prTitle": "[TAO-524][Chore] {{title}}",
    "commitMessagePrefix": "[TAO-524][Chore]",
    "branchPrefix": "renovate/",
    "labels": ["renovate"],
    "prConcurrentLimit": 5,
    "semanticCommits": "disabled",
    "dependencyDashboard": true,
    "onboarding": false,
    "requireConfig": "optional",
    "pin": { "enabled": false },
    "osvVulnerabilityAlerts": true,
    "vulnerabilityAlerts": { 
      "enabled": true,
      "prTitle": "[TAO-524][Chore] Update {{depName}} to {{newVersion}} (security)",
      "labels": ["security", "vulnerability"]
    },
    "packageRules": [
        {
            "ignoreDeps": [
              "pyarmor", "marshmallow", "packaging", "pandas" 
            ]
        },
        {
            "matchDatasources": ["pip_requirements"],
            "matchCurrentVersion": "/^[^0-9]/",
            "enabled": false,
            "description": "Disable updates for non-standard pip requirements (git+https, file:, etc.)"
        },
        {
            "description": "Group all non-security patch updates into one MR",
            "matchCategories": ["!security"],
            "matchUpdateTypes": ["patch"],
            "groupName": "Non-security patch updates",
            "groupSlug": "non-security-patch",
            "prTitle": "[TAO-524][Chore] Bulk non-security patch updates",
            "labels": ["renovate", "patch-update", "bulk"]
        },
        {
            "matchUpdateTypes": ["major"],
            "prTitle": "[TAO-524][Chore] Update {{depName}} to {{newVersion}} (major)",
            "labels": ["renovate", "major-update"]
        },
        {
            "matchUpdateTypes": ["minor"],
            "prTitle": "[TAO-524][Chore] Update {{depName}} to {{newVersion}} (minor)",
            "labels": ["dependencies", "renovate", "minor-update"]
        }
    ]
  }